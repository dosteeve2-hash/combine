# Base Postgres Neon — https://console.neon.tech
DATABASE_URL="postgresql://utilisateur:mot-de-passe@hote.neon.tech/neondb?sslmode=require"

# Secret de session Better Auth — générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# URL publique de l'application (http://localhost:3000 en développement)
BETTER_AUTH_URL="http://localhost:3000"

# Optional: required to verify new email addresses before granting invitations.
# Create an API key and verify the sender domain in Resend before enabling these.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="COMBINE <noreply@example.com>"

# Déverrouiller uniquement pour une base locale/test dédiée.
COMBINE_ALLOW_DEMO_SEED="false"
COMBINE_DEMO_PASSWORD=""

# Ne l’activer en production qu’après configuration d’une limitation IP de confiance.
COMBINE_PASSERELLE_ACTIVE="false"
